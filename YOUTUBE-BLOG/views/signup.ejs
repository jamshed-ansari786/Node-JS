<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include("./partials/head") %>
    <title>Signup</title>
  </head>
  <body>
    <%- include("./partials/nav") %>

    <main class="container py-4" style="max-width: 520px">
      <h1 class="mb-4">Create an account</h1>
      <form action="/user/signup" method="post">
        <div class="mb-3">
          <label for="fullName" class="form-label">Full name</label>
          <input
            type="text"
            class="form-control"
            id="fullName"
            name="fullName"
            autocomplete="name"
            maxlength="100"
            required
          />
        </div>
        <div class="mb-3">
          <label for="email" class="form-label">Email address</label>
          <input
            type="email"
            name="email"
            class="form-control"
            id="email"
            autocomplete="email"
            required
          />
        </div>
        <div class="mb-3">
          <label for="password" class="form-label">Password</label>
          <input
            name="password"
            type="password"
            class="form-control"
            id="password"
            autocomplete="new-password"
            minlength="8"
            maxlength="128"
            required
          />
          <div class="form-text">Use 8 to 128 characters.</div>
        </div>
        <button type="submit" class="btn btn-primary">Create account</button>
      </form>
      <p class="mt-3">Already registered? <a href="/user/signin">Sign in</a>.</p>
    </main>

    <%- include("./partials/script") %>
  </body>
</html>
