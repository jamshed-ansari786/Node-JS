<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include("./partials/head") %>
    <title>Homepage</title>
  </head>

  <body>
    <%- include("./partials/nav") %>

    <main class="container py-4">
      <div class="mb-4">
        <h1>Welcome to Blogify!</h1>
        <p class="text-muted">Discover stories and share your ideas.</p>
      </div>

      <% if (blogs.length === 0) { %>
        <div class="alert alert-light border" role="status">
          No blog posts yet. <% if (locals.user) { %>
            <a href="/blog/add-new">Write the first post</a>.
          <% } else { %>
            Sign in to create the first post.
          <% } %>
        </div>
      <% } else { %>
        <div class="row g-4">
          <% blogs.forEach(blog => { %>
            <div class="col-12 col-sm-6 col-lg-4">
              <article class="card h-100">
                <img
                  src="<%= blog.coverImageURL || '/default.png.avif' %>"
                  class="card-img-top"
                  alt="<%= blog.coverImageDescription || `Cover for ${blog.title}` %>"
                  style="height: 220px; object-fit: cover"
                >
                <div class="card-body d-flex flex-column">
                  <h2 class="h5 card-title"><%= blog.title %></h2>
                  <p class="card-text text-muted">
                    By <%= blog.createdBy ? blog.createdBy.fullName : "Unknown author" %>
                    · <%= new Date(blog.createdAt).toLocaleDateString() %>
                  </p>
                  <a href="/blog/<%= blog._id %>" class="btn btn-primary mt-auto align-self-start">
                    Read post
                  </a>
                </div>
              </article>
            </div>
          <% }) %>
        </div>
      <% } %>
    </main>

    <%- include("./partials/script") %>
  </body>
</html>
